#!/usr/bin/env bash
set -euo pipefail

DOCTOR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/harness-doctor"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

failures=0

pass() { printf '\033[32m✓\033[0m %s\n' "$1"; }
fail() {
  printf '\033[31m✗\033[0m %s\n    expected: %s\n    actual:   %s\n' "$1" "$2" "$3" >&2
  failures=$((failures + 1))
}

assert_equals() {
  if [ "$2" = "$3" ]; then pass "$1"; else fail "$1" "$2" "$3"; fi
}

new_root() {
  local root="$WORK/$1"
  mkdir -p "$root"
  printf '%s' "$root"
}

add_skill() {
  local root=$1 path=$2 body=${3:-body}
  mkdir -p "$root/$path"
  printf '%s\n' "$body" > "$root/$path/SKILL.md"
}

run_doctor() {
  set +e
  DOCTOR_STDOUT=$("$DOCTOR" "$@" 2>"$WORK/stderr")
  DOCTOR_STATUS=$?
  set -e
  DOCTOR_STDERR=$(cat "$WORK/stderr")
}

root=$(new_root empty-root)
run_doctor "$root"
assert_equals "an empty root produces no mapping" "0:" "$DOCTOR_STATUS:$DOCTOR_STDOUT"

root=$(new_root one-skill)
add_skill "$root" tdd
run_doctor "$root"
assert_equals "a root with one skill maps the name to its SKILL.md path" \
  "$(printf 'tdd\t%s/tdd/SKILL.md' "$root")" "$DOCTOR_STDOUT"

root=$(new_root nested-skill)
add_skill "$root" testing/tdd
run_doctor "$root"
assert_equals "a nested skill is discovered under its own directory name" \
  "$(printf 'tdd\t%s/testing/tdd/SKILL.md' "$root")" "$DOCTOR_STDOUT"

first=$(new_root two-roots/first)
second=$(new_root two-roots/second)
add_skill "$first" tdd
add_skill "$second" approval-tests
run_doctor "$first" "$second"
assert_equals "every root is scanned and the mapping is sorted by name" \
  "$(printf 'approval-tests\t%s/approval-tests/SKILL.md\ntdd\t%s/tdd/SKILL.md' "$second" "$first")" \
  "$DOCTOR_STDOUT"

first=$(new_root duplicate/first)
second=$(new_root duplicate/second)
add_skill "$first" tdd "one version"
add_skill "$second" tdd "another version"
run_doctor "$first" "$second"
assert_equals "a name backed by two distinct files is reported as a duplicate" \
  "duplicate: tdd" "$DOCTOR_STDERR"
assert_equals "a duplicate makes the doctor exit non-zero" "1" "$DOCTOR_STATUS"

first=$(new_root symlinked/first)
second=$(new_root symlinked/second)
add_skill "$first" tdd
ln -s "$first/tdd" "$second/tdd"
run_doctor "$first" "$second"
assert_equals "a skill reachable through a symlinked directory is discovered" \
  "$(printf 'tdd\t%s/tdd/SKILL.md\ntdd\t%s/tdd/SKILL.md' "$first" "$second")" "$DOCTOR_STDOUT"
assert_equals "a name reachable twice through a symlink to one file is not a duplicate" \
  "" "$DOCTOR_STDERR"

root=$(new_root with-backups)
add_skill "$root" .backups/20260619-174550/tdd
run_doctor "$root"
assert_equals "a skill discovered under .backups is reported as backup-sourced" \
  "backup: $root/.backups/20260619-174550/tdd/SKILL.md" "$DOCTOR_STDERR"
assert_equals "a backup-sourced skill makes the doctor exit non-zero" "1" "$DOCTOR_STATUS"

root=$(new_root clean-catalogue)
add_skill "$root" testing/tdd
add_skill "$root" practices/simple-design
run_doctor "$root"
assert_equals "a clean catalogue reports no problems and exits zero" \
  "0:" "$DOCTOR_STATUS:$DOCTOR_STDERR"

run_doctor
assert_equals "no root argument prints usage to stderr and exits non-zero" \
  "2:usage: harness-doctor ROOT [ROOT...]" "$DOCTOR_STATUS:$DOCTOR_STDERR"

run_doctor "$WORK/absent"
assert_equals "a root that does not exist is reported as an error" \
  "2:harness-doctor: no such root: $WORK/absent" "$DOCTOR_STATUS:$DOCTOR_STDERR"

if [ "$failures" -gt 0 ]; then
  printf '\n%d failing\n' "$failures" >&2
  exit 1
fi
printf '\nall green\n'
